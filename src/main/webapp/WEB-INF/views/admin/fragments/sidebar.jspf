<%-- 后台左侧导航栏（云服务商业务）。调用方需先定义 ${active} 标识当前激活项 --%>
<aside class="w-60 flex-shrink-0 bg-white border-r border-gray-200 min-h-screen flex flex-col">
    <%-- Logo --%>
    <div class="h-16 flex items-center px-6 border-b border-gray-100">
        <i class="fa-solid fa-cloud text-primary text-2xl"></i>
        <span class="ml-2 text-xl font-bold text-gray-900 tracking-[0.05em]">AJOU</span>
        <span class="ml-2 text-xs text-gray-400 font-medium">云服务商后台</span>
    </div>
    <%-- 导航 --%>
    <nav class="flex-1 px-3 py-4 space-y-1 text-sm">
        <a href="${pageContext.request.contextPath}/admin/dashboard"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'dashboard' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-gauge-high w-5"></i>
            <span class="ml-2">仪表盘</span>
        </a>
        <%-- 以下为后续阶段功能，雏形阶段占位禁用 --%>
        <a href="${pageContext.request.contextPath}/admin/products"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'products' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-layer-group w-5"></i>
            <span class="ml-2">云产品规格</span>
        </a>
        <a href="${pageContext.request.contextPath}/admin/instances"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'instances' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-server w-5"></i>
            <span class="ml-2">云实例管理</span>
        </a>
        <a href="${pageContext.request.contextPath}/admin/orders"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'orders' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-receipt w-5"></i>
            <span class="ml-2">订单管理</span>
        </a>
        <a href="${pageContext.request.contextPath}/admin/users"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'users' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-users w-5"></i>
            <span class="ml-2">用户管理</span>
        </a>
        <%-- 内容运营 --%>
        <div class="px-3 pt-4 pb-1 text-xs text-gray-400 font-medium">内容运营</div>
        <a href="${pageContext.request.contextPath}/admin/home"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'home' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-house w-5"></i>
            <span class="ml-2">首页配置</span>
        </a>
        <a href="${pageContext.request.contextPath}/admin/home-recommends"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'home-recommends' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-star w-5"></i>
            <span class="ml-2">首页推荐</span>
        </a>
        <a href="${pageContext.request.contextPath}/admin/dynamics"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'dynamics' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-bullhorn w-5"></i>
            <span class="ml-2">产品动态</span>
        </a>
        <a href="${pageContext.request.contextPath}/admin/dynamic-categories"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'dynamic-categories' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-tags w-5"></i>
            <span class="ml-2">动态分类</span>
        </a>
        <a href="${pageContext.request.contextPath}/admin/community"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'community' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-comments w-5"></i>
            <span class="ml-2">开发者社区</span>
        </a>
        <div class="px-3 pt-4 pb-1 text-xs text-gray-400 font-medium">系统</div>
        <a href="${pageContext.request.contextPath}/admin/settings"
           class="flex items-center px-3 py-2.5 rounded-lg font-medium ${active eq 'settings' ? 'bg-primary/10 text-primary' : 'text-gray-600 hover:bg-gray-50'}">
            <i class="fa-solid fa-gear w-5"></i>
            <span class="ml-2">系统设置</span>
        </a>
    </nav>
    <%-- 退出 --%>
    <div class="px-3 py-4 border-t border-gray-100">
        <a href="${pageContext.request.contextPath}/admin/logout"
           class="flex items-center px-3 py-2.5 rounded-lg text-sm text-gray-600 hover:bg-red-50 hover:text-red-500">
            <i class="fa-solid fa-right-from-bracket w-5"></i>
            <span class="ml-2">退出登录</span>
        </a>
    </div>
</aside>
